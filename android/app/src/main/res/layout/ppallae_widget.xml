<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="16dp">

    <TextView
        android:id="@+id/widget_region"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="지역 미설정"
        android:textColor="#5A6677"
        android:textSize="12sp"
        android:maxLines="1"
        android:ellipsize="end" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="bottom"
        android:layout_marginTop="2dp">

        <TextView
            android:id="@+id/widget_score"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="-"
            android:textColor="#1FA463"
            android:textSize="34sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="점"
            android:textColor="#1A2230"
            android:textSize="14sp"
            android:layout_marginBottom="6dp"
            android:layout_marginStart="2dp" />

        <TextView
            android:id="@+id/widget_grade"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#3A7BD5"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_reco"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="앱을 열어 빨래지수를 확인하세요"
        android:textColor="#3A4658"
        android:textSize="13sp"
        android:layout_marginTop="4dp"
        android:maxLines="2"
        android:ellipsize="end" />
</LinearLayout>
